<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>CleanResult</Title>
    <Authors>Gwynbleid85</Authors>
    <Description>Extension of CleanResult for WolverineFx.</Description>
    <PackageProjectUrl>https://github.com/Gwynbleid85/CleanResult</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>result error success aspnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>CleanResultLogo.png</PackageIcon>
    <RepositoryUrl>https://github.com/Gwynbleid85/CleanResult</RepositoryUrl>
    <Version>2.0.1</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CleanResult" Version="2.0.1"/>
    <PackageReference Include="WolverineFx" Version="6.48.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../docs/CleanResultLogo.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
